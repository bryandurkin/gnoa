{
  "$schema": "https://emdashcms.com/seed.schema.json",
  "version": "1",
  "meta": {
    "name": "GNOA News & Recognition",
    "description": "Blog posts for the GNOA site. All other pages stay in the repo.",
    "author": "GNOA"
  },
  "settings": {
    "title": "GNOA News & Recognition",
    "tagline": "Recruit. Train. Develop."
  },
  "collections": [
    {
      "slug": "posts",
      "label": "Posts",
      "labelSingular": "Post",
      "urlPattern": "/blog/{slug}",
      "supports": [
        "drafts",
        "revisions",
        "preview",
        "scheduling",
        "search",
        "seo"
      ],
      "commentsEnabled": false,
      "fields": [
        {
          "slug": "title",
          "label": "Title",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "featured_image",
          "label": "Featured Image",
          "type": "image"
        },
        {
          "slug": "excerpt",
          "label": "Summary",
          "type": "text"
        },
        {
          "slug": "content",
          "label": "Content",
          "type": "portableText",
          "searchable": true
        },
        {
          "slug": "source_name",
          "label": "Originally reported by",
          "type": "string"
        },
        {
          "slug": "source_url",
          "label": "Original story link",
          "type": "string"
        }
      ]
    }
  ],
  "taxonomies": [
    {
      "name": "category",
      "label": "Categories",
      "labelSingular": "Category",
      "hierarchical": false,
      "collections": [
        "posts"
      ],
      "terms": [
        {
          "slug": "news",
          "label": "News"
        },
        {
          "slug": "recognition",
          "label": "Recognition"
        },
        {
          "slug": "training",
          "label": "Training"
        }
      ]
    }
  ]
}