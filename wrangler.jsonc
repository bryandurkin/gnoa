{
  // Cloudflare Worker that serves the built site from dist/.
  // Draft worker: build command "npm run check" (draft build + QA gate). A QA failure stops the deploy.
  "name": "gnoa",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
