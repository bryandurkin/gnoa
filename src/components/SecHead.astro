---
// Centered section heading. bar = cyan underline (most sections). tagline = teal line under the heading (no bar).
// intro = one short paragraph under the heading.
const { heading, tagline, intro, bar = true } = Astro.props;
---
<div class={[`sec-head`, bar && !tagline && 'sec-head--bar', intro && 'sec-head--wide'].filter(Boolean).join(' ')}><h2>{heading}</h2>{tagline && <p class="sec-head__tag">{tagline}</p>}{intro && <p class="sec-head__intro">{intro}</p>}</div>
