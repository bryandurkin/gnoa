const { name, class: cls } = Astro.props;
if (!paths[name]) throw new Error(`Unknown icon "${name}". Use one of: ${Object.keys(paths).join(', ')}`);
---
<svg class={cls ? `icon ${cls}` : 'icon'} viewBox="0 0 24 24" aria-hidden="true" set:html={paths[name]} />
