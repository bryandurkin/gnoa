  cap: '<path d="M12 3.5 1 8.8l11 5.3 9-4.35V16h2V8.8z"/><path d="M5.5 12.3v3.6c0 1.8 2.9 3.4 6.5 3.4s6.5-1.6 6.5-3.4v-3.6L12 15.4z"/>',
