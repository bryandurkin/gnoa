---
// Registry: section "type" in page JSON -> component. Only GNOA kit sections are allowed.
import Hero from './sections/Hero.astro'; import SportStrip from './sections/SportStrip.astro';
import Benefits from './sections/Benefits.astro'; import SportTiles from './sections/SportTiles.astro';
import Split from './sections/Split.astro'; import Steps from './sections/Steps.astro';
import Band from './sections/Band.astro'; import Path from './sections/Path.astro';
import Testimonials from './sections/Testimonials.astro'; import Faq from './sections/Faq.astro';
import CtaBand from './sections/CtaBand.astro'; import Prose from './sections/Prose.astro';
import PostCards from './sections/PostCards.astro'; import Contact from './sections/Contact.astro';
const registry = { hero: Hero, 'page-hero': Hero, 'sport-strip': SportStrip, benefits: Benefits, 'sport-tiles': SportTiles, split: Split, steps: Steps, band: Band, path: Path, testimonials: Testimonials, faq: Faq, 'cta-band': CtaBand, prose: Prose, 'post-cards': PostCards, contact: Contact };
const { sections, pageName } = Astro.props;
if (!['hero', 'page-hero'].includes(sections[0]?.type)) throw new Error(`${pageName}: first section must be hero or page-hero`);
if (sections.at(-1)?.type !== 'cta-band') throw new Error(`${pageName}: last section must be cta-band`);
---
{sections.map(s => { const C = registry[s.type]; if (!C) throw new Error(`${pageName}: "${s.type}" is not a kit section`); return <C {...s} isPage={s.type === 'page-hero'} />; })}
