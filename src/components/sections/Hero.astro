---
// hero (home) and page-hero (inner pages). eyebrow: array of words (home, colored) or kicker: string (inner).
import Btn from '../Btn.astro';
const { eyebrow, kicker, title1, title2, lead, buttons = [], image, isPage = false } = Astro.props;
---
<section class={isPage ? 'hero page-hero' : 'hero'}>
  {image && <div class="hero__media"><img class="cover" src={image.src} alt={image.alt} fetchpriority="high" /></div>}
  <div class="wrap"><div class="hero__body">
    {eyebrow && <p class="eyebrow">{eyebrow.map((w, i) => <>{i > 0 && <span class="dot" aria-hidden="true">&bull;</span>}<span class={i < 2 ? `c${i + 1}` : undefined}>{w}</span></>)}</p>}
    {kicker && <p class="eyebrow">{kicker}</p>}
    <h1 class="hero__title">{title1}{title2 && <>{' '}<br />{title2}</>}</h1>
    <p class="hero__lead">{lead}</p>
    {buttons.length > 0 && <div class="hero__actions">{buttons.map((b, i) => <Btn {...b} variant={i === 0 ? 'cyan' : 'outline'} />)}</div>}
  </div></div>
</section>
