---
// Text and photo, photo fading into white. reverse = photo on the left.
// text or paragraphs; list = { heading (optional), items, columns (1 or 2) } checklist; after = paragraph or paragraphs after the list;
// aside = { heading, items, text } boxed checklist shown beside the text (use with reverse).
// subhead optional. image.fade = "short" keeps people at the photo's edge visible (narrower text). image.focus / image.focusPhone = crop position. image.stack = photo above the text on tablets too.
import Btn from '../Btn.astro'; import Icon from '../Icon.astro';
const { heading, subhead, text, paragraphs, list, after, aside, button, image, reverse = false } = Astro.props;
const paras = paragraphs ?? (text ? [text] : []);
const cls = ['split', reverse && 'split--reverse', image.fade === 'short' && 'split--open', image.stack && 'split--stack'].filter(Boolean).join(' ');
---
<section class={cls}>
  <div class="split__media"><img class={image.focus ? 'cover has-focus' : 'cover'} src={image.src} alt={image.alt} loading="lazy" style={image.focus && `--focus:${image.focus};--focus-phone:${image.focusPhone ?? image.focus}`} /></div>
  <div class="wrap"><div class={aside ? 'split__body split__body--wide' : 'split__body'}>
    <h2>{heading}</h2>
    {subhead && <p class="split__sub">{subhead}</p>}
    <div class={aside ? 'split__cols' : undefined}>
      <div>
        {paras.map(p => <p>{p}</p>)}
        {list && <>{list.heading && <h3 class="checklist__head">{list.heading}</h3>}<ul class={list.columns === 1 ? 'checklist checklist--one' : 'checklist'} style={`--rows:${list.columns === 1 ? list.items.length : Math.ceil(list.items.length / 2)}`}>{list.items.map(i => <li><Icon name="check" />{i}</li>)}</ul></>}
        {after && [after].flat().map(p => <p>{p}</p>)}
        {button && <Btn {...button} variant="teal" />}
      </div>
      {aside && <div>
        <div class="check-box"><h3 class="checklist__head">{aside.heading}</h3><ul class={aside.columns === 1 ? 'checklist checklist--one' : 'checklist'} style={`--rows:${aside.columns === 1 ? aside.items.length : Math.ceil(aside.items.length / 2)}`}>{aside.items.map(i => <li><Icon name="check" />{i}</li>)}</ul></div>
        {aside.text && <p class="check-box__after">{aside.text}</p>}
      </div>}
    </div>
  </div></div>
</section>
