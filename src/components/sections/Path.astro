---
// Photo cards joined by arrows. Items with "text" get the caption layout (label and text under the photo).
import Sec from '../Sec.astro'; import SecHead from '../SecHead.astro'; import Icon from '../Icon.astro'; import Btn from '../Btn.astro';
const { heading, tagline, intro, items, button, mist = true, join } = Astro.props;
const captions = items.some(i => i.text);
---
<Sec mist={mist} join={join}>
  <SecHead heading={heading} tagline={tagline} intro={intro} />
  <ol class={captions ? 'path path--captions' : 'path'}>
    {items.map(i => <li class="path__item">
      <div class="path__card"><img class="cover" src={i.image.src} alt={i.image.alt} loading="lazy" />{!captions && <span class="path__label">{i.label}</span>}</div>
      {captions && <div class="path__caption"><h3>{i.label}</h3><p>{i.text}</p></div>}
      <Icon name="arrow" class="path__arrow" />
    </li>)}
  </ol>
  {button && <div class="sec-cta"><Btn {...button} variant="teal" /></div>}
</Sec>
