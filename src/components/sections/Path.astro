---
import Sec from '../Sec.astro'; import SecHead from '../SecHead.astro'; import Icon from '../Icon.astro';
const { heading, tagline, items, mist = true, join } = Astro.props;
---
<Sec mist={mist} join={join}>
  <SecHead heading={heading} tagline={tagline} />
  <ol class="path">
    {items.map(i => <li class="path__item"><div class="path__card"><img class="cover" src={i.image.src} alt={i.image.alt} loading="lazy" /><span class="path__label">{i.label}</span></div><Icon name="arrow" class="path__arrow" /></li>)}
  </ol>
</Sec>
