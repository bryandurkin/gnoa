---
// Navy panel, photo right. text (one paragraph) or lines (short lines, tightly spaced). Button optional.
import Btn from '../Btn.astro';
const { heading, text, lines, button, image } = Astro.props;
---
<section class="band">
  {image && <div class="band__media"><img class="cover" src={image.src} alt={image.alt} loading="lazy" /></div>}
  <div class="wrap"><div class={lines ? 'band__body band__body--wide' : 'band__body'}>
    <h2>{heading}</h2>
    {text && <p>{text}</p>}
    {lines && <div class="band__lines">{lines.map(l => <p>{l}</p>)}</div>}
    {button && <Btn {...button} variant="cyan" />}
  </div></div>
</section>
