---
// blocks: [{h2} | {h3} | {p} | {ul: [..]} | {links: [{text, href}]}]
import Sec from '../Sec.astro';
const { blocks, mist = false, join } = Astro.props;
---
<Sec mist={mist} join={join}><div class="prose">
  {blocks.map(b => b.h2 ? <h2>{b.h2}</h2> : b.h3 ? <h3>{b.h3}</h3> : b.ul ? <ul>{b.ul.map(li => <li>{li}</li>)}</ul> : b.links ? <ul class="link-list">{b.links.map(l => <li><a href={l.href}>{l.text}</a></li>)}</ul> : <p>{b.p}</p>)}
</div></Sec>
