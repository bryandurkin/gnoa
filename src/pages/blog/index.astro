---
export const prerender = false;
import { getEmDashCollection } from 'emdash';
import Base from '../../layouts/Base.astro';
import Sections from '../../components/Sections.astro';
import page from '../../content/blog-index.json';
import { toPost } from '../../lib/posts.mjs';
import { MODE } from '../../mode.mjs';
const { entries, cacheHint } = await getEmDashCollection('posts', { orderBy: { published_at: 'desc' } });
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
if (MODE === 'draft') Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
const posts = entries.map(toPost);
const sections = page.sections.map(s => s.type === 'post-cards' ? { ...s, posts } : s);
---
<Base title={page.title} description={page.description} path="/blog/">
  <Sections sections={sections} pageName={page.name} />
</Base>
